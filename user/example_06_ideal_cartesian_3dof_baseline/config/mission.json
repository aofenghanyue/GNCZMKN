{
  "simulation": { "dt": 0.1, "duration": 0.2, "integrator": "rk4" },
  "environment": {
    "components": [
      { "type": "environment.standard_atmosphere", "name": "atmosphere", "config": {} }
    ]
  },
  "vehicles": [
    {
      "id": "interceptor",
      "perturbation": {
        "type": "perturbation.static",
        "name": "perturbation",
        "config": { "inputs": {} }
      },
      "form": {
        "components": [
          {
            "type": "form.cartesian_3dof.point_mass",
            "name": "dynamics",
            "config": {
              "initial_position": [0.0, 0.0, 1000.0],
              "initial_velocity": [250.0, 0.0, 0.0]
            }
          }
        ]
      },
      "common": [
        { "type": "vehicle.common.aero_assets_3dof.zero", "name": "aero_assets", "config": {} }
      ],
      "input": [
        { "type": "vehicle.input.cartesian_imu_3dof.ideal", "name": "imu", "config": {} },
        { "type": "vehicle.input.cartesian_satellite_nav_3dof.ideal", "name": "satnav", "config": {} },
        { "type": "vehicle.input.cartesian_air_data_3dof.ideal", "name": "air_data", "config": {} },
        {
          "type": "vehicle.input.cartesian_seeker_3dof.ideal",
          "name": "seeker",
          "config": { "target_truth_lookup_name": "target.truth" }
        }
      ],
      "process": [
        {
          "type": "vehicle.process.cartesian_phase_sequencer_3dof.ideal",
          "name": "phase",
          "config": { "phase_name": "boost" }
        },
        { "type": "vehicle.process.cartesian_trajectory_planner_3dof.ideal", "name": "planner", "config": {} },
        { "type": "vehicle.process.cartesian_navigation_3dof.ideal", "name": "navigation", "config": {} },
        { "type": "vehicle.process.cartesian_target_tracking_3dof.ideal", "name": "tracking", "config": {} },
        { "type": "vehicle.process.cartesian_guidance_3dof.ideal", "name": "guidance", "config": {} },
        { "type": "vehicle.process.cartesian_flight_control_3dof.ideal", "name": "flight_control", "config": {} },
        { "type": "vehicle.process.cartesian_control_allocation_3dof.ideal", "name": "control_allocation", "config": {} }
      ],
      "output": [
        { "type": "vehicle.output.mass_3dof.constant", "name": "mass", "config": { "mass_kg": 100.0 } },
        { "type": "vehicle.output.propulsion_3dof.zero", "name": "propulsion", "config": {} },
        { "type": "vehicle.output.actuator_3dof.ideal", "name": "actuator", "priority": 0, "config": {} },
        { "type": "vehicle.output.aerodynamics_3dof.zero", "name": "aero", "priority": 10, "config": {} }
      ],
      "interaction": {
        "components": [
          {
            "type": "interaction.cartesian_3dof.standard",
            "name": "interaction",
            "config": {}
          }
        ]
      }
    },
    {
      "id": "target",
      "form": {
        "components": [
          {
            "type": "form.target_point.kinematic",
            "name": "truth",
            "config": {
              "initial_position_ecef_m": [3000.0, 0.0, 1000.0],
              "velocity_ecef_mps": [0.0, 0.0, 0.0]
            }
          }
        ]
      },
      "common": [],
      "input": [],
      "process": [],
      "output": []
    }
  ],
  "outputs": {
    "directory": "user/outputs/example_06_ideal_cartesian_3dof_baseline",
    "format": "csv",
    "session_name": "ideal_cartesian_3dof_baseline",
    "record": {
      "interceptor.dynamics": "all",
      "interceptor.imu": "all",
      "interceptor.satnav": "all",
      "interceptor.air_data": "all",
      "interceptor.seeker": "all",
      "interceptor.phase": "all",
      "interceptor.planner": "all",
      "interceptor.navigation": "all",
      "interceptor.tracking": "all",
      "interceptor.guidance": "all",
      "interceptor.flight_control": "all",
      "interceptor.control_allocation": "all",
      "interceptor.mass": "all",
      "interceptor.propulsion": "all",
      "interceptor.actuator": "all",
      "interceptor.aero": "all",
      "interceptor.aero_assets": "all",
      "interceptor.interaction": "all",
      "target.truth": "all"
    }
  },
  "termination": {
    "type": "termination.engagement_cartesian_3dof",
    "name": "termination",
    "config": {
      "min_range_m": 1.0,
      "min_altitude_m": -1.0,
      "max_time_s": 0.1
    }
  },
  "summary": {
    "type": "summary.engagement_cartesian_3dof.ideal",
    "name": "summary",
    "config": {}
  }
}
