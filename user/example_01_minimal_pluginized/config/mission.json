{
    "simulation": {
        "dt": 0.1,
        "duration": 20.0,
        "integrator": "rk4"
    },
    "form": {
        "components": [
            {
                "type": "form.cartesian_3dof.point_mass",
                "name": "dynamics",
                "config": {
                    "initial_position": [0.0, 0.0, 1000.0],
                    "initial_velocity": [250.0, 0.0, 40.0]
                }
            }
        ]
    },
    "environment": {},
    "vehicle": {
        "common": [],
        "input": [],
        "process": [],
        "output": []
    },
    "interaction": {
        "components": [
            {
                "type": "interaction.cartesian_3dof.direct_accel",
                "name": "interaction",
                "config": {
                    "acceleration_mps2": [0.0, 0.0, -9.81]
                }
            }
        ]
    },
    "outputs": {
        "directory": "user/outputs/{timestamp}",
        "format": "csv",
        "session_name": "minimal_cartesian_3dof",
        "record": {
            "vehicle.dynamics": "all"
        }
    },
    "stop_conditions": [
        {
            "type": "component_field_below",
            "component": "vehicle.dynamics",
            "field": "altitude",
            "value": 0.0,
            "description": "Cartesian altitude below ground"
        }
    ]
}
