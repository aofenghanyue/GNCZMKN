              "launch_azimuth_rad": 1.5707963267948966,
              "initial_state": {
                "longitude_rad": 0.0,
                "latitude_rad": 0.0,
                "altitude_m": 1000.0,
                "speed_mps": 250.0,
                "flight_path_angle_rad": 0.0,
                "heading_angle_rad": 1.5707963267948966
              }
            }
          },
          {
